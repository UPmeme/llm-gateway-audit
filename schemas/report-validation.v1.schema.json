{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UPmeme/llm-gateway-audit/schemas/report-validation.v1.schema.json",
  "title": "llm-gateway-audit report-validation.v1",
  "type": "object",
  "required": ["schemaVersion", "valid", "issueCount", "issues", "privacy", "caveat"],
  "properties": {
    "schemaVersion": { "const": "report-validation.v1" },
    "valid": { "type": "boolean" },
    "issueCount": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "privacy": {
      "type": "object",
      "required": ["promptStored", "apiKeyStored", "rawResponseBodyStored"],
      "properties": {
        "promptStored": { "const": false },
        "apiKeyStored": { "const": false },
        "rawResponseBodyStored": { "const": false }
      }
    },
    "caveat": { "type": "string" }
  },
  "additionalProperties": true
}
